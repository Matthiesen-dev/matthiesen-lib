{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${mod_license}",
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_releases": "${github_url}"
      }
    }
  },
  "accessWidener": "matthiesen-lib.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.matthiesen.fabric.matthiesen_lib.MatthiesenLibFabric"
    ],
    "client": [
      "dev.matthiesen.fabric.matthiesen_lib.MatthiesenLibFabricClient"
    ]
  },
  "mixins": [
    "matthiesen_lib.mixins.json"
  ],
  "depends": {
    "minecraft": "1.21.1",
    "${api_mod_id}": "*"
  },
  "suggests": {
    "emberstextapi": ">=3.0.0 <4.0.0",
    "fabric-permissions-api-v0": "*"
  }
}